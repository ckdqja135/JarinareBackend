# ─────────────────────────────────────────────────────────────
# 자리나래 백엔드 환경변수 예시. 실제 값은 .env 에 채우세요. (.env 는 커밋 금지)
# 누락 시 서버 시작 단계(env.validation)에서 오류가 발생합니다.
# ─────────────────────────────────────────────────────────────

# 서버 포트
PORT=3000

# 공통
APP_TIMEZONE=Asia/Seoul

# ── 데이터베이스 (MariaDB/MySQL) ──
RDB_HOST=localhost
RDB_PORT=3306
RDB_USERNAME=root
RDB_PASSWORD=
RDB_DATABASE=test

# ── 공공데이터 열차 API (서버에서만 사용, 클라이언트 노출 금지) ──
# 예: http://apis.data.go.kr/1613000/TrainInfoService
TRAIN_API_BASE_URL=
TRAIN_API_SERVICE_KEY=
# 매일 자정(Asia/Seoul) 동기화. cron 5필드.
STATION_SYNC_CRON=0 0 * * *
STATION_SYNC_INITIAL_ENABLED=true
TRAIN_API_TIMEOUT_MS=5000
TRAIN_API_RETRY_COUNT=2
TRAIN_TIME_CACHE_TTL_SECONDS=300

# ── 카카오 OAuth (client_secret 은 서버에서만 사용) ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
# 콤마로 구분된 허용 redirectUri 목록
KAKAO_ALLOWED_REDIRECT_URIS=

# ── Firebase Admin (서비스 계정) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 개인 키는 개행을 \n 으로 이스케이프하여 한 줄로 입력하고 큰따옴표로 감쌉니다.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── (후속 pass 용) ──
SEAT_LOCK_TTL_SECONDS=60
SEAT_LOCK_HEARTBEAT_SECONDS=20
DEPARTURE_NOTIFICATION_MINUTES_BEFORE=30
